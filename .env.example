# Copy this file to .env and fill in your own values.
# Never commit your actual .env file or real credentials.

# Google Cloud OAuth client (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Directory where per-user OAuth token JSON files are stored
TOKEN_STORE_DIR=.tokens

# Comma-separated list of frontend origins allowed to call this API (CORS)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
